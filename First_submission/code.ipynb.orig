    "pipe_ridge = Ridge()\n",
    "\n",
    "results = cross_validation_pipeline(\n",
    "    X=X,           \n",
    "    y=y,\n",
    "    model=pipe_ridge,\n",
    "    n_folds=10,\n",
    "    n_bins=5,\n",
    "    random_state=42\n",
    ")"
   ]
