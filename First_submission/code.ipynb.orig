   "source": [
    "pipe_lasso = Lasso()\n",
    "\n",
    "results = cross_validation_pipeline(\n",
    "    X=X,           \n",
    "    y=y,\n",
    "    model=pipe_lasso,\n",
    "    n_folds=10,\n",
    "    n_bins=5,\n",
    "    random_state=42\n",
    ")"
   ]
