    "def adj_r2(y_true, y_pred, n_features):\n",
    "\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "    n = len(y_true)\n",
    "    return 1 - (1 - r2) * (n - 1) / (n - n_features - 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 138,
