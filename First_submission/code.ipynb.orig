    "def create_full_pipeline(model):\n",
    "\n",
    "    preprocessor = create_preprocessing_pipeline()\n",
    "    \n",
    "    pipeline = Pipeline([\n",
    "        ('preprocessor', preprocessor),\n",
    "        ('model', model)\n",
    "    ])\n",
    "    \n",
    "    return pipeline"
   ]
  },
