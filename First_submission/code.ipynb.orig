      " 11  paintQuality%     64304 non-null  float64       \n",
      " 12  previousOwners    64304 non-null  float64       \n",
      " 13  stated_no_damage  64304 non-null  bool          \n",
      "dtypes: bool(1), datetime64[ns](1), float64(6), int64(2), object(4)\n",
