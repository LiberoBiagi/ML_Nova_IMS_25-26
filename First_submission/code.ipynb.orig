      "4       bmw       6389  1266.699922  574.691434  0.987655\n",
      "5     skoda       3699   891.293941  381.907851  0.979980\n",
      "6      opel       8131   527.212172  287.250018  0.978671\n",
      "7  mercedes      10088  1130.101369  622.695632  0.989967\n",
      "8   hyundai       2885   546.443129  348.129427  0.991728\n"
     ]
