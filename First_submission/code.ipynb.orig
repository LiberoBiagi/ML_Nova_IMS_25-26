    {
     "data": {
      "text/plain": [
       "carID               0\n",
       "Brand               0\n",
       "model               0\n",
       "year                0\n",
       "price               0\n",
       "transmission        0\n",
       "mileage             0\n",
       "fuelType            0\n",
       "tax                 0\n",
       "mpg                 0\n",
